<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AgentSessionStore / AgentSessionStoreKey are evaluation-only (MAAI001); accepted for this prototype. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.26.0" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.26.0-preview.261023.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.26.0-preview.261023.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="policy-index.json" />
  </ItemGroup>

</Project>
